# Required: where to store downloaded files and manifest
# Supports: local path, s3://bucket/prefix, gs://bucket/prefix
BRREG_STORAGE_PATH=./data

# Async download settings
BRREG_MAX_CONCURRENT=50
BRREG_REQUESTS_PER_SECOND=10.0
BRREG_MAX_RETRIES=5
BRREG_CHECKPOINT_INTERVAL=1000

# Maximum runtime in minutes (for GitHub Actions time limits)
# Set to 0 for unlimited (local runs)
BRREG_MAX_RUNTIME_MINUTES=0

# Logging level: DEBUG, INFO, WARNING, ERROR
BRREG_LOG_LEVEL=INFO

# AWS credentials (only needed for s3:// storage paths)
# Prefer OIDC/IAM roles in CI — set these only for local development
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-north-1

# GCS credentials (only needed for gs:// storage paths)
# Prefer workload identity in CI — set these only for local development
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
